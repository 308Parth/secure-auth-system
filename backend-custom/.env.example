# Server Port and Environment
PORT=3000
NODE_ENV=development

# PostgreSQL Connection String (or separate host/port/user/pass/db)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/secure_auth_eval?sslmode=disable

# CORS Configuration (allows frontend origin)
CORS_ORIGIN=http://localhost:8080

# Security and Rate Limiting Parameters
MAX_FAILED_ATTEMPTS=5
LOCKOUT_MS=60000
SESSION_TTL_MS=1800000

# File Storage Configuration (local directory)
STORAGE_LOCAL_DIR=./storage
